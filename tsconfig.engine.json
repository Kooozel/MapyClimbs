{
  // The climb engine's closure, compiled the way its future consumers will (#68):
  // no DOM lib, no ambient @types, so an accidental `document.` or `chrome.` in
  // these files fails here rather than at extraction time.
  //
  // It does NOT catch an import reaching back into the extension: types.ts is
  // plain TypeScript and compiles cleanly under this config too. The value-level
  // half of that boundary is asserted in scripts/build-cli.mjs (ENGINE_CLOSURE),
  // against the module graph esbuild actually walks. Adding a file to the engine
  // means adding it to both lists, on purpose.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "files": [
    "src/climb-engine.ts",
    "src/climb-engine.config.ts",
    "src/climb-types.ts",
    "src/max-gradient.ts",
    "src/scoring.ts"
  ]
}
